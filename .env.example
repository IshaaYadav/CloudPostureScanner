# ==========================================================
# Cloud Posture Scanner - Environment Configuration
# ==========================================================

# 1. AWS Authentication & CLI Profile
# Set your named AWS CLI profile (e.g., configured via 'aws configure --profile posture-dev')
# Leave blank to use standard Boto3 credential chain (environment variables, instance profile, ECS task role)
AWS_PROFILE=posture-dev

# Optional: Direct credentials (prefer named profiles or IAM roles in production)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=

# 2. AWS Region Configuration
AWS_DEFAULT_REGION=ap-south-1
# Comma-separated list of regions to scan for multi-region EC2 inventory
AWS_SCAN_REGIONS=ap-south-1

# 3. Dedicated Private Amazon S3 Storage Bucket
# Replace with the name of your private S3 bucket to persist scan reports
# Scan reports are stored at: scans/YYYY/MM/DD/<scan_id>.json with SSE-S3 (AES256) encryption
AWS_POSTURE_BUCKET=replace-with-your-private-bucket-name

# 4. Scanner Operating Mode
# Set to 'false' to connect to real AWS; set to 'true' for offline demo/simulation mode
USE_MOCK=false

# 5. Application Server
HOST=0.0.0.0
PORT=8000
